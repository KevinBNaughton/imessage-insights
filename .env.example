# BlueBubbles server (keep this local; never expose its password to the assistant)
BLUEBUBBLES_URL=http://localhost:1234
BLUEBUBBLES_PASSWORD=

# Token your assistant uses to call THIS service. Generate with: openssl rand -hex 32
INSIGHTS_TOKEN=

# Where this service listens. Keep 127.0.0.1 and put a tunnel in front for remote access.
HOST=127.0.0.1
PORT=8787

# Local state (done/snoozed chats)
DB_PATH=./insights.db

# Triage tuning
LOOKBACK_DAYS=14
NEEDS_REPLY_MIN_AGE_HOURS=1
WAITING_MIN_AGE_HOURS=48
# Comma-separated names people call you, used to detect mentions in group chats
MY_NAMES=Kevin
